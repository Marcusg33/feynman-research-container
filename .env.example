# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
#   cp .env.example .env
#   $EDITOR .env
#
# docker compose reads .env from the project directory automatically, for both
# `docker compose run` and `docker compose up`. No --env-file flag needed as
# long as .env sits next to compose.yml.
OPENROUTER_API_KEY=sk-or-v1-replace-me
